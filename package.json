{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "prisma generate && prisma migrate deploy && vite build",
    "postinstall": "prisma generate",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "gen:api": "node scripts/gen-api.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:banks": "node scripts/test-banks-flow.mjs",
    "test:trade-filters": "tsx server/utils/db/trade-filters.test.ts",
    "test:bank-stats": "tsx shared/bank-stats-delta.test.ts",
    "test:path-segments": "tsx scripts/pathSegments.test.ts",
    "test:calculation": "tsx shared/calculation.test.ts",
    "test:kyiv-dates": "tsx server/lib/kyiv-dates.test.ts",
    "test:i18n": "tsx shared/i18n/i18n.test.ts && tsx shared/i18n/api-i18n.test.ts",
    "test:unit": "npm run test:bank-stats && npm run test:path-segments && npm run test:trade-filters && npm run test:calculation && npm run test:kyiv-dates",
    "test:all": "npm run lint && npm run test:unit && npm run test:api && npm run test:banks"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@vercel/node": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
