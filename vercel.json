{
  "regions": ["fra1"],
  "functions": {
    "api/**/*.ts": {
      "memory": 1024
    }
  },
  "buildCommand": "prisma generate && prisma migrate deploy && vite build",
  "devCommand": "npm run dev",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/)(?!.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
