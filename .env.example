# Neon Postgres — pooled connection (for app / serverless runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — direct connection (required for prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Required on first run to seed the default admin user (nickname: admin)
ADMIN_INITIAL_PASSWORD="change-me-to-a-strong-password"

# Demo quick-login on auth page (enabled by default; set to "false" to hide)
# DEMO_LOGIN_ENABLED="false"
# DEMO_STUDENT_PASSWORD="Danilo#2026!"

# Optional: public app URL for external integrations
APP_URL="https://your-app.vercel.app"
