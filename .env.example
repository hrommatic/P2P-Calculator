# Neon Postgres — pooled connection (for app / serverless runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30&connection_limit=5"

# Neon Postgres — direct connection (required for prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Required on first run to seed the default admin user (nickname: admin)
ADMIN_INITIAL_PASSWORD="change-me-to-a-strong-password"

# Optional: public app URL for external integrations
APP_URL="https://your-app.vercel.app"

# API integration tests (npm run test:api, test:banks) — credentials only in .env
TEST_LOGIN="DONTDELETE"
TEST_PASSWORD="your-test-password"
# Optional override for test scripts
# TEST_API_URL="https://your-app.vercel.app"

# Local full stack: npm run dev:full — UI http://localhost:5173, API proxied to :3000
